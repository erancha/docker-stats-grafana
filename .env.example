# Settings of the stats pipeline. ./scripts/init-env.sh copies this file to .env and fills in the
# generated values.

# The Kafka or Redpanda broker, as this machine reaches it. localhost:9092 is the local Redpanda
# that ./scripts/start.sh runs; with --no-kafka, give a remote broker's address that the consumer
# container can reach too (not localhost).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# The topics the consumer reads, one per monitored host or group of hosts. The second is optional.
# ./scripts/collect-stats.sh publishes to KAFKA_TOPIC_1 unless told otherwise.
KAFKA_TOPIC_1=docker-stats-local
KAFKA_TOPIC_2=

# InfluxDB. The organization, bucket, admin password and token are applied when the influxdb-data
# volume is first created; changing them later needs ./scripts/docker-helper.sh --stop --volumes.
INFLUXDB_ORG=docker-stats
INFLUXDB_BUCKET=container-metrics
# Generated by init-env.sh. The web UI at http://localhost:8086 signs in as admin.
INFLUXDB_ADMIN_PASSWORD=
# Generated by init-env.sh. The consumer writes with it and Grafana reads with it.
INFLUXDB_TOKEN=

# Generated by init-env.sh. Grafana at http://localhost:3100 signs in as admin.
GRAFANA_ADMIN_PASSWORD=

# Docker Hub account that ./scripts/build-push-consumer.sh pushes the consumer image to. Only
# that script needs it.
DOCKER_USERNAME=
